# Copy to .env and fill in. Never commit .env.

# --- Supabase Postgres (Project Settings -> Database -> Connection string) ---
# App runtime: transaction pooler, port 6543.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Prisma CLI (migrations): session pooler or direct connection, port 5432.
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase API (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable key (or the legacy "anon" key). Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Secret key (or the legacy "service_role" key). Server-only: storage + admin.
SUPABASE_SECRET_KEY=""

# Public base URL used in sign-in emails. Optional locally (falls back to the request origin).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- OpenRouter (server-side only). https://openrouter.ai/keys ---
# Free models: ~20 req/min, 50 req/day unless you have bought >=10 credits.
OPENROUTER_API_KEY=""
AI_MODEL_PRIMARY="nvidia/nemotron-3.5-super-vl:free"
AI_MODEL_FALLBACK="google/gemma-4-31b-it:free"
# Max AI model requests per user per UTC day (cache hits are free). Default 20.
AI_DAILY_REQUEST_LIMIT="20"
# Per-model timeout for one AI request, in ms (free models are slow). Default 150000.
AI_TIMEOUT_MS="150000"
# Speech-to-text for voice interview answers (paid, not free: Voxtral is ~$0.003/min).
AI_MODEL_TRANSCRIBE="mistralai/voxtral-mini-transcribe"
AI_MODEL_TRANSCRIBE_FALLBACK="openai/whisper-large-v3"

# --- Scheduled jobs (Vercel Cron sends this as a Bearer token; set the same value in Vercel) ---
CRON_SECRET=""
# Days with no activity before an application is marked ghosted.
APPLICATION_GHOST_DAYS="21"
